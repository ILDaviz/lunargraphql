{
    "name": "ildaviz/lunargraphql",
    "description": "GraphQL API for LunarPHP using Nuwave Lighthouse",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "lunar",
        "lunarphp",
        "graphql",
        "lighthouse",
        "headless",
        "ecommerce",
        "api"
    ],
    "authors": [
        {
            "name": "David Galet",
            "email": "davidgalet+lunargraphql@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "lunarphp/core": "^2.0.0-alpha.6|^2.0",
        "nuwave/lighthouse": "^6.0",
        "spatie/laravel-package-tools": "^1.16",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Lunargraphql\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lunargraphql\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lunargraphql\\LunargraphqlServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/pest"
        ],
        "pint": [
            "vendor/bin/pint"
        ]
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.32"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
